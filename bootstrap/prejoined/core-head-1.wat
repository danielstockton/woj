  ;; Print a woj String to stdout via WASI fd_write
  ;; Memory layout: [0..3]=nwritten [4..7]=iov_base [8..11]=iov_len [12..]=data
  (func $__repl_print_str (param $str anyref)
    (local $chars (ref null $CharArray))
    (local $len i32)
    (local $i i32)
    (if (ref.is_null (local.get $str)) (then (return)))
    (if (i32.eqz (ref.test (ref $String) (local.get $str))) (then (return)))
    (local.set $chars (struct.get $String $data (ref.cast (ref $String) (local.get $str))))
    (local.set $len (array.len (local.get $chars)))
    (if (i32.eqz (local.get $len)) (then (return)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_s (local.get $i) (local.get $len)))
        (i32.store8 (i32.add (i32.const 12) (local.get $i))
                    (array.get_u $CharArray (local.get $chars) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (i32.store (i32.const 4) (i32.const 12))
    (i32.store (i32.const 8) (local.get $len))
    (drop (call $fd_write (i32.const 1) (i32.const 4) (i32.const 1) (i32.const 0))))

  ;; print!: convert any value to string via str1, write to stdout, return nil
  (func $print_BANG_ (param $val anyref) (result anyref)
    (call $__repl_print_str (call $str1 (local.get $val)))
    (ref.null none))
  ;; pr!: convert any value to string via pr-str1 (EDN), write to stdout, return nil
  (func $pr_BANG_ (param $val anyref) (result anyref)
    (call $__repl_print_str (call $pr_str1 (local.get $val)))
    (ref.null none))
  ;; print-str!: write a pre-built String to stdout, return nil
  (func $print_str_BANG_ (param $str anyref) (result anyref)
    (call $__repl_print_str (local.get $str))
    (ref.null none))

  ;; wasi_slurp: read entire file contents as a String
  ;; Uses WASI preview1: path_open, fd_filestat_get, fd_read, fd_close
  ;; Memory layout (offset 16384+):
  ;;   [16384..16387] = fd result from path_open
  ;;   [16388..16395] = iov struct (base, len)
  ;;   [16396..16399] = nread result
  ;;   [16400..17423] = filename (up to 1024 bytes)
  ;;   [17424..17487] = filestat buffer (64 bytes)
  ;;   [17488..] = file read buffer
  (func $wasi_slurp (param $filename anyref) (result anyref)
    (local $name_len i32)
    (local $fd i32)
    (local $errno i32)
    (local $fsize i32)
    (local $total_read i32)
    (local $nread i32)
    (local $remain i32)
    ;; Copy filename to linear memory at 16400
    (local.set $name_len (call $string__GT_mem_BANG_ (local.get $filename) (i32.const 16400)))
    (if (i32.eqz (local.get $name_len))
      (then (return (ref.null none))))
    ;; path_open(dirfd=3, dirflags=1, path=16400, path_len, oflags=0,
    ;;           rights_base=fd_read|fd_seek|fd_filestat_get, rights_inheriting=0, fdflags=0, &fd=16384)
    (local.set $errno (call $path_open
      (i32.const 3)         ;; dirfd: preopened directory
      (i32.const 1)         ;; dirflags: SYMLINK_FOLLOW
      (i32.const 16400)     ;; path pointer
      (local.get $name_len) ;; path length
      (i32.const 0)         ;; oflags: none
      (i64.const 42)        ;; rights_base: fd_read(2) | fd_seek(8) | fd_filestat_get(32) = 42
      (i64.const 0)         ;; rights_inheriting
      (i32.const 0)         ;; fdflags
      (i32.const 16384)))   ;; fd result pointer
    (if (i32.ne (local.get $errno) (i32.const 0))
      (then (return (ref.null none))))
    (local.set $fd (i32.load (i32.const 16384)))
    ;; fd_filestat_get to determine file size
    ;; filestat struct at 17424 (64 bytes): dev(8), ino(8), filetype(1)+pad(7), nlink(8), size(8@offset32), ...
    (local.set $errno (call $fd_filestat_get (local.get $fd) (i32.const 17424)))
    (if (i32.ne (local.get $errno) (i32.const 0))
      (then
        (drop (call $fd_close (local.get $fd)))
        (return (ref.null none))))
    ;; File size at offset 17424+32 = 17456 (i64, take low 32 bits)
    (local.set $fsize (i32.wrap_i64 (i64.load (i32.const 17456))))
    ;; Cap at reasonable max (1MB - 17488 = ~1030000 bytes)
    (if (i32.gt_u (local.get $fsize) (i32.const 1030000))
      (then
        (drop (call $fd_close (local.get $fd)))
        (return (ref.null none))))
    ;; Read file data starting at offset 17488
    (local.set $total_read (i32.const 0))
    (block $read_done
      (loop $read_loop
        (local.set $remain (i32.sub (local.get $fsize) (local.get $total_read)))
        (br_if $read_done (i32.le_s (local.get $remain) (i32.const 0)))
        ;; Setup iov: base=17488+total_read, len=remain
        (i32.store (i32.const 16388) (i32.add (i32.const 17488) (local.get $total_read)))
        (i32.store (i32.const 16392) (local.get $remain))
        ;; fd_read(fd, &iov=16388, 1, &nread=16396)
        (local.set $errno (call $fd_read (local.get $fd) (i32.const 16388) (i32.const 1) (i32.const 16396)))
        (br_if $read_done (i32.ne (local.get $errno) (i32.const 0)))
        (local.set $nread (i32.load (i32.const 16396)))
        (br_if $read_done (i32.eqz (local.get $nread)))
        (local.set $total_read (i32.add (local.get $total_read) (local.get $nread)))
        (br $read_loop)))
    ;; Close fd
    (drop (call $fd_close (local.get $fd)))
    ;; Convert bytes to String
    (call $mem__GT_string (i32.const 17488) (local.get $total_read)))

  ;; wasi_stderr: write a String to stderr (fd 2) for error messages
  (func $wasi_stderr (param $str anyref) (result anyref)
    (local $chars (ref null $CharArray))
    (local $len i32)
    (local $i i32)
    (if (ref.is_null (local.get $str)) (then (return (ref.null none))))
    (if (i32.eqz (ref.test (ref $String) (local.get $str))) (then (return (ref.null none))))
    (local.set $chars (struct.get $String $data (ref.cast (ref $String) (local.get $str))))
    (local.set $len (array.len (local.get $chars)))
    (if (i32.eqz (local.get $len)) (then (return (ref.null none))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_s (local.get $i) (local.get $len)))
        (i32.store8 (i32.add (i32.const 12) (local.get $i))
                    (array.get_u $CharArray (local.get $chars) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (i32.store (i32.const 4) (i32.const 12))
    (i32.store (i32.const 8) (local.get $len))
    (drop (call $fd_write (i32.const 2) (i32.const 4) (i32.const 1) (i32.const 0)))
    (ref.null none))

  ;; now_ms: get current monotonic time in milliseconds (for profiling)
  (func $now_ms (result anyref)
    (drop (call $clock_time_get (i32.const 1) (i64.const 1000000) (i32.const 16384)))
    (ref.i31 (i32.wrap_i64 (i64.div_u (i64.load (i32.const 16384)) (i64.const 1000000)))))

  ;; wasi_args: get command-line arguments as a vector of strings
  ;; Uses WASI args_sizes_get and args_get
  ;; Memory layout (reuses 16384+ scratch space):
  ;;   [16384..16387] = argc
  ;;   [16388..16391] = argv_buf_size
  ;;   [16392..] = argv pointers (argc * 4 bytes)
  ;;   [16392 + argc*4 ..] = argv buffer (null-terminated strings)
  (func $wasi_args (result anyref)
    (local $argc i32)
    (local $argv_buf_size i32)
    (local $argv_ptrs i32)
    (local $argv_buf i32)
    (local $i i32)
    (local $ptr i32)
    (local $str_start i32)
    (local $str_len i32)
    (local $result anyref)
    ;; Get sizes first
    (if (i32.ne (call $args_sizes_get (i32.const 16384) (i32.const 16388)) (i32.const 0))
      (then (return (call $empty_vector))))
    (local.set $argc (i32.load (i32.const 16384)))
    (local.set $argv_buf_size (i32.load (i32.const 16388)))
    (if (i32.eqz (local.get $argc))
      (then (return (call $empty_vector))))
    ;; argv pointers at 16392, argv buffer after that
    (local.set $argv_ptrs (i32.const 16392))
    (local.set $argv_buf (i32.add (local.get $argv_ptrs) (i32.mul (local.get $argc) (i32.const 4))))
    ;; Get actual args
    (if (i32.ne (call $args_get (local.get $argv_ptrs) (local.get $argv_buf)) (i32.const 0))
      (then (return (call $empty_vector))))
    ;; Build vector of strings
    (local.set $result (call $empty_vector))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_s (local.get $i) (local.get $argc)))
        ;; Get pointer to this arg string
        (local.set $str_start (i32.load (i32.add (local.get $argv_ptrs) (i32.mul (local.get $i) (i32.const 4)))))
        ;; Find length (null-terminated)
        (local.set $str_len (i32.const 0))
        (block $len_done
          (loop $len_loop
            (br_if $len_done (i32.eqz (i32.load8_u (i32.add (local.get $str_start) (local.get $str_len)))))
            (local.set $str_len (i32.add (local.get $str_len) (i32.const 1)))
            (br $len_loop)))
        ;; Convert to GC string and conj onto vector
        (local.set $result (call $vector_conj (local.get $result)
          (call $mem__GT_string (local.get $str_start) (local.get $str_len))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (local.get $result))